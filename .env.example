PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB stores contact requests (NoSQL evidence)
MONGO_URI=mongodb://localhost:27017/nantes-wifi-solutions

# PostgreSQL stores services and offers (relational/SQL evidence)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nantes_wifi?schema=public

JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@nantes-wifi.fr
ADMIN_PASSWORD=replace-with-a-strong-seed-password
BREVO_API_KEY=
MAIL_FROM=contact@nantes-wifi.fr
MAIL_TO=admin@nantes-wifi.fr
